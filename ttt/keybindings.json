{
  "editor.moveLineUp": "ctrl+shift+pageup",
  "editor.moveLineDown": "ctrl+shift+pagedown",
  "multicursor.addCursorAbove": "ctrl+shift+up",
  "multicursor.addCursorBelow": "ctrl+shift+down",
  "editor.copy": [
    "ctrl+c",
    "ctrl+insert"
  ],
  "sidebar.outline": "ctrl+shift+o",
  "sidebar.focus": "ctrl+e",
  "bitbucket-review.show": "ctrl+shift+p",
  "panel.toggle": "ctrl+j",
  "tab.next": [
    "ctrl+tab",
    "ctrl+pagedown"
  ],
  "tab.prev": [
    "ctrl+shift+tab",
    "ctrl+pageup"
  ],
  "editor.hover": "ctrl+i",
  "menu.file": "ctrl+f10",
  "menubar.toggle": "f10",
  "editor.findReferences": [
    "shift+f12",
    "ctrl+l r"
  ],
  "editor.goToImplementation": [
    "ctrl+f12",
    "ctrl+l i"
  ],
  "editor.autocomplete": "ctrl+u",
  "terminal.toggle": "ctrl+`",
  "file.quickOpen": "ctrl+t",
  "search.replace": [
    "ctrl+h",
    "ctrl+r"
  ],
  "sidebar.explorer": "ctrl+shift+e",
  "sidebar.search": "ctrl+shift+f",
  "sidebar.changes": "ctrl+shift+g",
  "editor.deleteLine": "ctrl+shift+k"
}
