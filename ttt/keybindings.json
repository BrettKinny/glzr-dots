{
  "editor.moveLineUp": "ctrl+alt+up",
  "editor.moveLineDown": "ctrl+alt+down",
  "multicursor.addCursorAbove": "ctrl+shift+up",
  "multicursor.addCursorBelow": "ctrl+shift+down",
  "editor.copy": [
    "ctrl+c",
    "ctrl+insert"
  ],
  "sidebar.outline": "ctrl+k o",
  "sidebar.focus": "ctrl+e",
  "bitbucket-review.show": "ctrl+k p",
  "panel.toggle": "ctrl+j",
  "tab.next": [
    "ctrl+tab",
    "ctrl+pagedown"
  ],
  "tab.prev": "ctrl+pageup",
  "editor.hover": "ctrl+i",
  "menu.file": "ctrl+f10",
  "menubar.toggle": "f10",
  "editor.findReferences": [
    "shift+f12",
    "ctrl+l r"
  ],
  "editor.goToImplementation": [
    "ctrl+f12",
    "ctrl+l i"
  ],
  "editor.autocomplete": "ctrl+u",
  "terminal.toggle": "ctrl+`",
  "file.quickOpen": "ctrl+t",
  "search.replace": [
    "ctrl+h",
    "ctrl+r"
  ],
  "editor.sortLinesAsc": ""
}
